# قالب متغيرات بيئة النشر Self-Hosted — مهمة #3
#
# الاستخدام:
#   cp .env.selfhosted.example .env.selfhosted
#   ثم عدّل كل قيمة أدناه بقيمة حقيقية قبل التشغيل.
#   .env.selfhosted مُستثنى من git عمداً (راجع .gitignore) — لا يُرفَع أبداً.
#
# توليد كلمات مرور/أسرار قوية عشوائياً:
#   openssl rand -base64 24     # لكلمات المرور
#   openssl rand -hex 32        # لـ JWT_SECRET_KEY تحديداً
#
# التشغيل:
#   docker compose -f docker-compose.selfhosted.yml --env-file .env.selfhosted up -d --build

# ── قاعدة بيانات core-api ───────────────────────────────────────────────
POSTGRES_USER=alqaim
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=alqaim

# ── قاعدة بيانات ai-platform (مستقلة عن أعلاه) ──────────────────────────
AI_POSTGRES_USER=alqaim_ai
AI_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AI_POSTGRES_DB=alqaim_ai

# ── MinIO (مُجهَّز للاستخدام المستقبلي — راجع الملاحظة في docker-compose.selfhosted.yml) ──
MINIO_ROOT_USER=alqaim
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16CHARS_MIN

# ── مصادقة core-api ──────────────────────────────────────────────────────
# سرّ توقيع JWT — لا تستخدم القيمة الافتراضية في الكود (CHANGE_ME_IN_ENV) إطلاقاً
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS

# ── عنوان core-api كما يراه متصفح المستخدم (وليس اسم الحاوية الداخلي) ────
# يُخبَز داخل حزمة web وقت البناء (Next.js NEXT_PUBLIC_*) — مثال:
#   http://203.0.113.10:8000          (IP عام مباشر)
#   https://api.yourdomain.com        (خلف نطاق/reverse proxy)
PUBLIC_API_URL=http://CHANGE_ME_SERVER_IP_OR_DOMAIN:8000

# ── منافذ مكشوفة على المضيف (اختياري تغييرها) ────────────────────────────
CORE_API_PORT=8000
WEB_PORT=3000

# ── مصادقة خدمة-لخدمة: ai-platform → core-api (مسارات /internal/* فقط) ───
# مفتاح ثابت (self-hosted، بلا OAuth كامل) يُرسِله ai-platform في ترويسة
# X-Service-Token عند استدعاء GET /internal/partners/known-suppliers و
# GET /internal/catalog/known-products. راجع README_عضو-1.md §4 و
# README_عضو-2.md §3 للعقد الكامل، و platform_core/auth_middleware.py
# (get_service_context) للتنفيذ في core-api.
#
# ⚠️ ملاحظة دمج مهمة: عضو 1 وعضو 2 كتبا هذا كل من طرفه بأسماء متغيرات بيئة
# مختلفة (ALQAIM_AI_PLATFORM_SERVICE_TOKEN عند 1، AI_PLATFORM_SERVICE_TOKEN
# عند 2) دون أن يريا docker-compose.selfhosted.yml أو config.py للطرف
# الآخر فعلياً. عند الدمج هنا تبيّن أن كلا الاسمين المقترحين لم يكونا
# مطابقين لما يقرأه pydantic-settings فعلياً في الحاوية:
#   - core-api  (env_prefix="ALQAIM_")     → يقرأ ALQAIM_AI_PLATFORM_SERVICE_TOKEN
#   - ai-platform (env_prefix="ALQAIM_AI_") → يقرأ ALQAIM_AI_AI_PLATFORM_SERVICE_TOKEN (!)
# تم توحيد متغير بيئة واحد هنا على مستوى .env (القيمة المصدر)، ثم تعيينه
# صراحة لاسم كل حاوية الصحيح في docker-compose.selfhosted.yml (وdocker-compose.yml
# للتطوير) — راجع التعليق هناك. لا تعتمد على الاسم أدناه كاسم متغير بيئة
# داخل أي حاوية مباشرة؛ هو فقط مصدر القيمة لملفات compose.
AI_PLATFORM_SERVICE_TOKEN=CHANGE_ME_RANDOM_64_HEX_CHARS
