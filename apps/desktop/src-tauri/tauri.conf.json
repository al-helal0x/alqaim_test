{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlQaim",
  "version": "0.1.0",
  "identifier": "com.alqaim.erp.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "beforeBuildCommand": "npm --prefix ../../web run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "القائم — AlQaim ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
