{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@alqaim/api-types": ["../../packages/api-types/src/index.ts"],
      "@alqaim/ui-kit": ["../../packages/ui-kit/src/index.tsx"],
      "@alqaim/i18n": ["../../packages/i18n/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/ui-kit/src/**/*.tsx",
    "../../packages/i18n/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
